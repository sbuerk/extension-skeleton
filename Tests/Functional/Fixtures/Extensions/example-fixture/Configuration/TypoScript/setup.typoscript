# TypoScript of the fixture extension, loaded by the functional tests through
# setUpFrontendRootPage().
#
# It renders the content elements of the default column and nothing else. The
# rendering definition of the plugin generated by ExtensionUtility::configurePlugin()
# is deliberately overridden below.

page = PAGE
page {
    typeNum = 0

    10 = CONTENT
    10 {
        table = tt_content
        select {
            orderBy = sorting
            where = {#colPos} = 0
        }
    }
}

# The generated definition is "=< lib.contentElement", which is provided by
# EXT:fluid_styled_content. That extension is not a dependency here, and a
# fixture extension has no business pulling one in just to render a plugin, so
# the content object is defined directly instead.
tt_content.testsexamplefixture_hello = COA
tt_content.testsexamplefixture_hello {
    10 = EXTBASEPLUGIN
    10 {
        extensionName = TestsExampleFixture
        pluginName = Hello
    }
}
